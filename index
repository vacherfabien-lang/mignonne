// BONS PLANS
// Stockes dans le noeud Firebase 'infos' (deja autorise par les regles).
// La carte utilise Leaflet, charge a la demande : si le CDN est
// indisponible, la vue Tuiles continue de fonctionner normalement.
// ══════════════════════════════
let bonsPlans = [];
let bpListenerOn = false;
let bpView = 'tiles';
let bpCatFilter = 'all';
let editingBpId = null;
let bpLat = null, bpLng = null;
let bpMap = null, bpMarkers = [], bpPickMap = null, bpPickMarker = null;
// Rue des Planches, 35400 Saint-Malo (source : Google Places, 13/09/2026)
const SAINT_MALO = [48.6571836, -2.0015529];

const BP_CATS = {
  resto:    { icon:'🍽️', label:'Restaurant / bar',   color:'#c8553d' },
  balade:   { icon:'🥾', label:'Balade / randonnée', color:'#5b7553' },
  plage:    { icon:'🏖️', label:'Plage / baignade',   color:'#2d5f7c' },
  commerce: { icon:'🛒', label:'Commerce / marché',  color:'#b8862e' },
  activite: { icon:'🎡', label:'Activité / visite',  color:'#7d4e7a' },
  autre:    { icon:'✨', label:'Autre',              color:'#6b7a85' }
};
function bpCat(c){ return BP_CATS[c] || BP_CATS.autre; }

// ── Chargement de Leaflet a la demande ──
let leafletPromise = null;
function loadLeaflet(){
  if(window.L) return Promise.resolve();
  if(leafletPromise) return leafletPromise;
  leafletPromise = new Promise((resolve, reject)=>{
    const css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
    document.head.appendChild(css);
    const s = document.createElement('script');
    s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    s.onload = ()=>resolve();
    s.onerror = ()=>reject(new Error('carte indisponible'));
    document.head.appendChild(s);
  });
  return leafletPromise;
}

// ── Lecture / ecriture ──
async function loadBonsPlans(){
  try{
    const snap = await get(infosRef);
    const v = snap.exists() ? snap.val() : null;
    bonsPlans = (v && v.bonsplans && typeof v.bonsplans==='object')
      ? Object.values(v.bonsplans).filter(x=>x && typeof x==='object' && x.id)
      : [];
    if(v && v.marees && typeof v.marees==='object') mareesExtra = v.marees;
    if(v && v.errors && typeof v.errors==='object'){
      errLog = Object.values(v.errors).filter(x=>x && x.ts).sort((a,b)=>a.ts-b.ts);
    }
  }catch(e){
    console.error('Firebase bons plans load error:', e);
    bonsPlans = [];
  }
  renderBonsPlans();
  if(!bpListenerOn){
    bpListenerOn = true;
    onValue(infosRef, (snap)=>{
      const v = snap.exists() ? snap.val() : null;
      bonsPlans = (v && v.bonsplans && typeof v.bonsplans==='object')
        ? Object.values(v.bonsplans).filter(x=>x && typeof x==='object' && x.id)
        : [];
      if(v && v.marees && typeof v.marees==='object'){ mareesExtra = v.marees; render(); }
      renderBonsPlans();
    }, (err)=>{console.error('Listen bons plans error:', err)});
  }
}

async function saveBonsPlans(){
  try{
    const bp = {};
    bonsPlans.forEach(p=>{ bp[p.id] = p; });
    // update() ne touche qu'aux clés fournies : marées et journal d'erreurs,
    // qui vivent dans le même nœud, restent intacts.
    await update(infosRef, { _pass: FAMILY_PASS, bonsplans: bp });
  }catch(e){
    console.error('Firebase bons plans save error:', e);
    toast('Erreur de sauvegarde — vérifiez votre connexion');
  }
}

// ── Filtres et rendu ──
function setBpView(v){
  bpView = v;
  document.getElementById('bpSwTiles').classList.toggle('active', v==='tiles');
  document.getElementById('bpSwMap').classList.toggle('active', v==='map');
  document.getElementById('bpTiles').style.display = (v==='tiles') ? '' : 'none';
  document.getElementById('bpMapWrap').style.display = (v==='map') ? '' : 'none';
  if(v==='map') initBpMap();
}
function setBpCatFilter(c){ bpCatFilter = c; renderBonsPlans(); }

function bpFiltered(){
  const q = (document.getElementById('bpSearch')?.value || '').trim().toLowerCase();
  return bonsPlans.filter(p=>{
    if(bpCatFilter!=='all' && (p.cat||'autre')!==bpCatFilter) return false;
    if(!q) return true;
    return ((p.titre||'')+' '+(p.desc||'')+' '+(p.auteur||'')).toLowerCase().includes(q);
  }).sort((a,b)=> (a.titre||'').localeCompare(b.titre||'','fr'));
}

function renderBonsPlans(){
  // Filtres par categorie
  const fc = document.getElementById('bpFilters');
  if(fc){
    const counts = {};
    bonsPlans.forEach(p=>{ const c=p.cat||'autre'; counts[c]=(counts[c]||0)+1; });
    let h = '<button class="bp-chip'+(bpCatFilter==='all'?' on':'')+'" onclick="setBpCatFilter(\'all\')">Tout ('+bonsPlans.length+')</button>';
    Object.keys(BP_CATS).forEach(c=>{
      if(!counts[c]) return;
      h += '<button class="bp-chip'+(bpCatFilter===c?' on':'')+'" onclick="setBpCatFilter(\''+c+'\')">'+BP_CATS[c].icon+' '+escTxt(BP_CATS[c].label)+' ('+counts[c]+')</button>';
    });
    fc.innerHTML = h;
  }

  // Tuiles
  const t = document.getElementById('bpTiles');
  if(t){
    const list = bpFiltered();
    if(!list.length){
      t.innerHTML = '<div class="bp-empty"><svg class="dessin-vide" viewBox="0 0 200 236" role="img" aria-label="Dessin de la façade"><use href="#facade"/></svg>Aucun bon plan pour l\'instant. Ajoute le premier !</div>';
    } else {
      t.innerHTML = list.map(p=>{
        const c = bpCat(p.cat);
        const loc = (p.lat!=null && p.lng!=null)
          ? '<span class="bp-tile-loc">📍 sur la carte</span>' : '';
        const lien = p.lien
          ? '<a class="bp-tile-link" href="'+escTxt(p.lien)+'" target="_blank" rel="noopener">Ouvrir le lien ↗</a>' : '';
        const sig = p.auteur ? '<span class="bp-tile-by">par '+escTxt(p.auteur)+'</span>' : '';
        return '<article class="bp-tile" style="--bpc:'+c.color+'">'
          + '<div class="bp-tile-head"><span class="bp-tile-icon">'+c.icon+'</span>'
          + '<h4 class="bp-tile-title">'+escTxt(p.titre||'Sans nom')+'</h4></div>'
          + '<div class="bp-tile-cat">'+escTxt(c.label)+'</div>'
          + (p.desc ? '<p class="bp-tile-desc">'+escTxt(p.desc)+'</p>' : '')
          + lien
          + '<div class="bp-tile-foot">'+sig+loc
          + '<button class="bp-tile-edit" onclick="openBpEdit(\''+p.id+'\')">Modifier</button></div>'
          + '</article>';
      }).join('');
    }
  }
  if(bpView==='map') refreshBpMarkers();
}

// ── Carte principale ──
function initBpMap(){
  const msg = document.getElementById('bpMapMsg');
  loadLeaflet().then(()=>{
    if(!bpMap){
      bpMap = L.map('bpMap').setView(SAINT_MALO, 14);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap'
      }).addTo(bpMap);
    }
    setTimeout(()=>{ bpMap.invalidateSize(); refreshBpMarkers(); }, 120);
    if(msg) msg.textContent = '';
  }).catch(()=>{
    if(msg) msg.textContent = "La carte n'a pas pu être chargée (connexion ?). La vue Tuiles reste disponible.";
  });
}

function refreshBpMarkers(){
  if(!bpMap || !window.L) return;
  bpMarkers.forEach(m=>bpMap.removeLayer(m));
  bpMarkers = [];
  const list = bpFiltered().filter(p=>p.lat!=null && p.lng!=null);
  list.forEach(p=>{
    const c = bpCat(p.cat);
    const icon = L.divIcon({
      className: 'bp-pin-wrap',
      html: '<div class="bp-pin" style="background:'+c.color+'">'+c.icon+'</div>',
      iconSize: [30,30], iconAnchor: [15,15]
    });
    const m = L.marker([p.lat, p.lng], {icon}).addTo(bpMap);
    m.bindPopup(
      '<div class="bp-pop"><strong>'+escTxt(p.titre||'Sans nom')+'</strong>'
      + '<div class="bp-pop-cat">'+escTxt(c.label)+'</div>'
      + (p.desc?'<p>'+escTxt(p.desc)+'</p>':'')
      + (p.auteur?'<div class="bp-pop-by">par '+escTxt(p.auteur)+'</div>':'')
      + '</div>'
    );
    bpMarkers.push(m);
  });
  const msg = document.getElementById('bpMapMsg');
  if(msg && !list.length) msg.textContent = 'Aucun bon plan localisé pour ce filtre.';
  else if(msg) msg.textContent = '';
}

