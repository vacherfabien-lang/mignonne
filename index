(function(){
  var noms = ['cancelNew','cancelSel','changeUserName','changeZone','checkForUpdate','checkRecPass','clearBpLoc','closeBp','closeEdit','closeJackpot','closeRecAuthorEdit','closeRecEdit','closeRecLightbox','closeRecRead','closeZonesModal','deleteBk','deleteBp','deleteRec','downloadRecettesPdf','exportAllData','forceReload','navMonth','navYear','onQuickPhotoSelected','onRecPhotoSelected','openBpEdit','openBpNew','openRecAuthorEdit','openRecEdit','openRecLightbox','openRecNew','openRecPhotosEdit','openRecRead','openZonesModal','quickAddPhoto','removeRecPhoto','renderBonsPlans','renderInfos','renderRecettes','saveBk','saveBp','saveNew','saveRec','saveRecAuthor','saveWelcomeName','setBpCatFilter','setBpView','skipWelcome','startNew','switchSection','toggleBpPicker','toggleFerie','toggleMaree','toggleVac','updateNewDatesInfo'];
  var prevenu = 0;
  function patienter(){
    var now = Date.now();
    if(now - prevenu < 2500) return;
    prevenu = now;
    var t = document.getElementById('toast');
    if(t){
      t.textContent = 'Chargement en cours, un instant…';
      t.classList.add('show');
      setTimeout(function(){ t.classList.remove('show'); }, 2000);
    }
  }
  for(var i=0;i<noms.length;i++){
    if(typeof window[noms[i]] === 'undefined') window[noms[i]] = patienter;
  }
})();
</script>

