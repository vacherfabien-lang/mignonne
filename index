function mareeCoverageNote(annee){
  try{
  if(!showMaree) return '';
  const has = Object.keys(MAREES).some(k=>k.startsWith(annee+'-'))
           || Object.keys(mareesExtra||{}).some(k=>k.startsWith(annee+'-'));
  if(has) return '';
  return '<div class="maree-warn">Coefficients de marée non disponibles pour '+annee
       + ' — les données officielles du SHOM ne sont pas encore publiées.</div>';
  }catch(e){
    // Un avertissement secondaire ne doit jamais empêcher le calendrier de s'afficher.
    console.warn('mareeCoverageNote:', e);
    return '';
  }
}
