function getTide(iso){
  if(mareesExtra && mareesExtra[iso] != null) return mareesExtra[iso]; return MAREES[iso] != null ? MAREES[iso] : null; }
function tideClass(coef){
  if(coef==null) return '';
  if(coef<45) return 'tide-1';
  if(coef<70) return 'tide-2';
  if(coef<95) return 'tide-3';
  if(coef<105) return 'tide-4';
  return 'tide-5';
}
function tideLabel(coef){ return coef==null ? '' : ('coef '+coef); }
// Hauteur de la barre de maree : les coefficients vont de 20 a ~120.
// Barres verticales cote a cote : leur sommet dessine la houle du mois.
// Niveau d'eau de la cellule, en pourcentage de sa hauteur.
// Plafonne a 78 % pour ne jamais noyer le numero du jour, en haut.
function tideLevel(coef){
  if(coef==null) return null;
  const pct = ((coef - 20) / 100) * 78;
  return Math.max(5, Math.min(78, pct));
}

// Surface de l'eau inclinee : le bord gauche rejoint la veille a mi-hauteur,
// le bord droit rejoint le lendemain. Le milieu reste au niveau reel du jour.
// Les segments se touchent donc d'une case a l'autre : plus d'escalier,
// une ligne continue qui dessine la houle.
function tideSvg(iso, coef){
  const own = tideLevel(coef);
  if(own == null) return '';
  const lv = tideLevel(getTide(addD(iso,-1)));
  const nv = tideLevel(getTide(addD(iso, 1)));
  const gauche = (lv == null) ? own : (lv + own) / 2;
  const droite = (nv == null) ? own : (own + nv) / 2;
  const yG = (100 - gauche).toFixed(2);
  const yD = (100 - droite).toFixed(2);
  const fort = coef >= mareeMin;
  return '<svg class="tide-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">'
       + '<polygon points="0,' + yG + ' 100,' + yD + ' 100,100 0,100" fill="url(#'
       + (fort ? 'tideGradFort' : 'tideGrad') + ')"/>'
       + '<line class="tide-crest' + (fort ? ' fort' : '') + '" x1="0" y1="' + yG
       + '" x2="100" y2="' + yD + '"/>'
       + '</svg>';
}

