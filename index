// ══════════════════════════════
function stripPass(val){
  // Retire la clé technique _pass et ne garde que les entrees reelles
  if(!val || typeof val !== 'object') return {};
  const out = {};
  Object.keys(val).forEach(k=>{ if(!k.startsWith('_')) out[k] = val[k]; });
  return out;
}

async function exportAllData(){
  const btn = document.getElementById('btnExport');
  const oldLabel = btn ? btn.textContent : '';
  if(btn){ btn.disabled = true; btn.textContent = '⏳ Lecture en cours…'; }
  try{
    // Lecture seule de tous les noeuds
    const [bkSnap, hSnap, recSnap, cpSnap, caSnap, infSnap] = await Promise.all([
      get(bookingsRef), get(historyRef), get(recettesRef),
      get(collectorPhotosRef), get(collectorAuthorsRef), get(infosRef)
    ]);

    const dump = {
      _meta: {
        application: 'Mignonne — Saint-Malo',
        exporte_le: new Date().toISOString(),
        format: 'sauvegarde-complete-v1',
        note: 'Sauvegarde integrale des donnees Firebase. Conserver ce fichier.'
      },
      bookings:          bkSnap.exists()  ? stripPass(bkSnap.val())  : {},
      history:           hSnap.exists()   ? stripPass(hSnap.val())   : {},
      recettes:          recSnap.exists() ? stripPass(recSnap.val()) : {},
      collector_photos:  cpSnap.exists()  ? stripPass(cpSnap.val())  : {},
      collector_authors: caSnap.exists()  ? stripPass(caSnap.val())  : {},
      infos:             infSnap.exists() ? stripPass(infSnap.val()) : {}
    };

    const nb = {
      sejours:  Object.keys(dump.bookings).length,
      histo:    Object.keys(dump.history).length,
      recettes: Object.keys(dump.recettes).length,
      photos:   Object.keys(dump.collector_photos).length,
      plans:    (dump.infos && dump.infos.bonsplans) ? Object.keys(dump.infos.bonsplans).length : 0
    };
    dump._meta.contenu = nb;

    const json = JSON.stringify(dump, null, 2);
    const blob = new Blob([json], {type:'application/json'});
    const url  = URL.createObjectURL(blob);
    const d    = new Date();
    const pad  = n => String(n).padStart(2,'0');
    const nom  = 'mignonne-sauvegarde-' + d.getFullYear() + pad(d.getMonth()+1) + pad(d.getDate()) + '-' + pad(d.getHours()) + pad(d.getMinutes()) + '.json';

    const a = document.createElement('a');
    a.href = url; a.download = nom;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(()=>URL.revokeObjectURL(url), 2000);

    const ko = Math.round(json.length/1024);
    toast('Sauvegarde : ' + nb.sejours + ' séjours, ' + nb.recettes + ' recettes, ' + nb.plans + ' bons plans (' + ko + ' Ko)');
  }catch(e){
    console.error('Export error:', e);
    toast('Export impossible — verifiez votre connexion');
  }finally{
    if(btn){ btn.disabled = false; btn.textContent = oldLabel || '💾 Exporter les données'; }
  }
}


