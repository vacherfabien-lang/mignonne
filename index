function closeBp(){
  document.getElementById('modalBp').classList.remove('show');
  hideBpPicker();
  editingBpId = null;
}
function updateBpLocState(){
  const el = document.getElementById('bpLocState');
  const clr = document.getElementById('bpClearLocBtn');
  if(bpLat!=null && bpLng!=null){
    el.textContent = 'Lieu enregistré : ' + bpLat.toFixed(4) + ', ' + bpLng.toFixed(4);
    el.className = 'bp-loc-state set';
    clr.style.display = '';
  } else {
    el.textContent = "Aucun lieu — n'apparaîtra pas sur la carte";
    el.className = 'bp-loc-state';
    clr.style.display = 'none';
  }
}
function clearBpLoc(){ bpLat=null; bpLng=null; if(bpPickMarker && bpPickMap){bpPickMap.removeLayer(bpPickMarker);bpPickMarker=null;} updateBpLocState(); }
function hideBpPicker(){
  const w = document.getElementById('bpPickWrap');
  if(w) w.style.display = 'none';
  const b = document.getElementById('bpPickBtn');
  if(b) b.textContent = '📍 Placer sur la carte';
}
function toggleBpPicker(){
  const w = document.getElementById('bpPickWrap');
  const b = document.getElementById('bpPickBtn');
  if(w.style.display !== 'none'){ hideBpPicker(); return; }
  w.style.display = '';
  b.textContent = 'Masquer la carte';
  loadLeaflet().then(()=>{
    if(!bpPickMap){
      bpPickMap = L.map('bpPickMap').setView(SAINT_MALO, 14);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {maxZoom:19, attribution:'© OpenStreetMap'}).addTo(bpPickMap);
      bpPickMap.on('click', (e)=>{
        bpLat = e.latlng.lat; bpLng = e.latlng.lng;
        if(bpPickMarker) bpPickMap.removeLayer(bpPickMarker);
        bpPickMarker = L.marker([bpLat,bpLng]).addTo(bpPickMap);
        updateBpLocState();
      });
    }
    setTimeout(()=>{
      bpPickMap.invalidateSize();
      if(bpLat!=null && bpLng!=null){
        if(bpPickMarker) bpPickMap.removeLayer(bpPickMarker);
        bpPickMarker = L.marker([bpLat,bpLng]).addTo(bpPickMap);
        bpPickMap.setView([bpLat,bpLng], 14);
      }
    }, 150);
  }).catch(()=>{
    w.innerHTML = '<div class="bp-pick-hint">Carte indisponible. Le bon plan sera enregistré sans lieu.</div>';
  });
}

async function saveBp(){
  const titre = document.getElementById('bpTitre').value.trim();
  if(!titre){toast('Indiquez un nom');return}
  const cat  = document.getElementById('bpCat').value;
  const desc = document.getElementById('bpDesc').value.trim();
  let lien   = document.getElementById('bpLien').value.trim();
  if(lien && !/^https?:\/\//i.test(lien)) lien = 'https://' + lien;
  const who = ensureUserName() || 'Anonyme';
  const now = new Date().toISOString();
  if(editingBpId){
    const i = bonsPlans.findIndex(x=>x.id===editingBpId);
    if(i>=0) bonsPlans[i] = { ...bonsPlans[i], titre, cat, desc, lien,
      lat:bpLat, lng:bpLng, modifiePar:who, updatedAt:now };
  } else {
    bonsPlans.push({ id:'bp_'+Date.now(), titre, cat, desc, lien,
      lat:bpLat, lng:bpLng, auteur:who, createdAt:now });
  }
  await saveBonsPlans();
  closeBp(); renderBonsPlans();
  toast(editingBpId?'Bon plan modifié ✓':'Bon plan ajouté ✓');
}
async function deleteBp(){
  if(!editingBpId) return;
  const p = bonsPlans.find(x=>x.id===editingBpId);
  if(!p) return;
  if(!(await askConfirm('Supprimer « '+(p.titre||'ce bon plan')+' » ?', {title:'Supprimer le bon plan', yes:'Supprimer', danger:true}))) return;
  bonsPlans = bonsPlans.filter(x=>x.id!==editingBpId);
  await saveBonsPlans();
  closeBp(); renderBonsPlans();
  toast('Bon plan supprimé');
}


// ══════════════════════════════
// DETECTION DE NOUVELLE VERSION
// Le fichier garde toujours le meme nom, donc le navigateur sert volontiers
// une copie en cache. On interroge periodiquement le fichier en ignorant le
// cache : si la version publiee differe de celle qui tourne, on propose de
// recharger. Aucune donnee n'est touchee.
// ══════════════════════════════
function currentPageUrl(){
  return location.pathname.replace(/[^/]*$/, '') + 'index.html';
}
async function checkForUpdate(silent){
  try{
    const r = await fetch(currentPageUrl() + '?_=' + Date.now(), { cache:'no-store' });
    if(!r.ok) return;
    const txt = await r.text();
    const m = txt.match(/const APP_VERSION\s*=\s*'([^']+)'/);
    if(!m) return;
    if(m[1] !== APP_VERSION) showUpdateBanner(m[1]);
  }catch(e){
    if(!silent) console.warn('Verification de version impossible:', e);
  }
}
function showUpdateBanner(newV){
  if(document.getElementById('updBanner')) return;
  const b = document.createElement('div');
  b.id = 'updBanner';
  b.className = 'upd-banner';
  b.innerHTML = '<span>Une nouvelle version (' + newV + ') est disponible.</span>'
              + '<button onclick="forceReload()">Mettre à jour</button>';
  document.body.appendChild(b);
}
function forceReload(){
  // On repart sur une URL neuve : le navigateur ne peut pas servir son cache.
  const base = location.href.split('?')[0].split('#')[0];
  location.replace(base + '?v=' + Date.now());
}


// ══════════════════════════════
// LIVRE DE RECETTES EN PDF
// Genere a la demande depuis les donnees vivantes : photos comprises,
// auteurs a jour, et pied de page signe sur chaque page.
// jsPDF est charge uniquement au moment du clic.
// ══════════════════════════════
let jspdfPromise = null;
function loadJsPDF(){
  if(window.jspdf && window.jspdf.jsPDF) return Promise.resolve();
  if(jspdfPromise) return jspdfPromise;
  jspdfPromise = new Promise((resolve, reject)=>{
    const s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
    s.onload = ()=>resolve();
    s.onerror = ()=>reject(new Error('jsPDF indisponible'));
    document.head.appendChild(s);
  });
  return jspdfPromise;
}

// Mesure une image base64 pour conserver ses proportions dans le PDF
function imgSize(dataUrl){
  return new Promise((resolve)=>{
    const im = new Image();
    im.onload  = ()=>resolve({w:im.naturalWidth, h:im.naturalHeight});
    im.onerror = ()=>resolve(null);
    im.src = dataUrl;
  });
}

async function downloadRecettesPdf(){
  const btn = document.getElementById('btnRecPdf');
  const old = btn ? btn.textContent : '';
  if(btn){ btn.disabled = true; btn.textContent = '⏳ Préparation…'; }
  try{
    await loadJsPDF();
    const who = ensureUserName() || 'Anonyme';
    const now = new Date();
    const p2 = n => String(n).padStart(2,'0');
    const dateFr = p2(now.getDate())+'/'+p2(now.getMonth()+1)+'/'+now.getFullYear();

    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({unit:'mm', format:'a4'});
    const PW = 210, PH = 297, M = 18;
    const CW = PW - M*2;

    // Liste complete : recettes du livre + nouveautes famille
    const livre = RECETTES_LOULI.map(r=>{
      const ph = collectorPhotos[r.id] ? collectorPhotos[r.id] : (r.photos||[]);
      const au = collectorAuthors[r.id] || r.auteur || 'Gourmand inconnu';
      return { ...r, photos: ph, auteur: au, _type:'Recette historique' };
    });
    const fam = recettes.map(r=>({ ...r, _type:'Nouveauté famille' }));
    const all = livre.concat(fam);

    // ── Couverture ──
    doc.setFillColor(244, 237, 225); doc.rect(0, 0, PW, PH, 'F');
    doc.setTextColor(29, 43, 54);
    doc.setFont('times', 'italic'); doc.setFontSize(34);
    doc.text('Recettes de famille', PW/2, 110, {align:'center'});
    doc.setFontSize(15);
    doc.text('Mignonne · Saint-Malo', PW/2, 124, {align:'center'});
    doc.setDrawColor(45, 95, 124); doc.setLineWidth(0.6);
    doc.line(PW/2 - 26, 133, PW/2 + 26, 133);
    doc.setFont('helvetica', 'normal'); doc.setFontSize(10);
    doc.setTextColor(107, 122, 133);
    doc.text(all.length + ' recettes', PW/2, 145, {align:'center'});
    doc.text('Téléchargé par ' + who + ' le ' + dateFr, PW/2, 152, {align:'center'});

    // ── Une recette par page ──
    for(let i = 0; i < all.length; i++){
      const r = all[i];
      doc.addPage();
      let y = M + 4;

      doc.setTextColor(29, 43, 54);
      doc.setFont('times', 'italic'); doc.setFontSize(19);
      const tl = doc.splitTextToSize(r.titre || 'Sans titre', CW);
      doc.text(tl, M, y); y += tl.length * 8 + 1;

      doc.setFont('helvetica', 'normal'); doc.setFontSize(9);
      doc.setTextColor(107, 122, 133);
      doc.text((r.auteur || 'Gourmand inconnu') + '  ·  ' + r._type, M, y);
      y += 4;
      doc.setDrawColor(232, 221, 200); doc.setLineWidth(0.4);
      doc.line(M, y, PW - M, y); y += 7;

      // Photos
      const photos = Array.isArray(r.photos) ? r.photos.slice(0, 3) : [];
      if(photos.length){
        const gap = 4;
        const bw = (CW - gap * (photos.length - 1)) / photos.length;
        let maxH = 0;
        for(let k = 0; k < photos.length; k++){
          const sz = await imgSize(photos[k]);
          if(!sz) continue;
          const h = Math.min(bw * (sz.h / sz.w), 55);
          const w = h * (sz.w / sz.h);
          try{
            doc.addImage(photos[k], 'JPEG', M + k * (bw + gap) + (bw - w) / 2, y, w, h);
          }catch(e){ console.warn('Photo ignorée dans le PDF', e); }
          if(h > maxH) maxH = h;
        }
        if(maxH) y += maxH + 7;
      }

      // Bloc de texte avec passage de page si besoin
      const block = (titre, texte)=>{
        if(!texte || !texte.trim()) return;
        if(y > PH - M - 24){ doc.addPage(); y = M + 4; }
        doc.setFont('helvetica', 'bold'); doc.setFontSize(8.5);
        doc.setTextColor(45, 95, 124);
        doc.text(titre.toUpperCase(), M, y); y += 5;
        doc.setFont('helvetica', 'normal'); doc.setFontSize(10);
        doc.setTextColor(58, 74, 86);
        const lines = doc.splitTextToSize(texte.replace(/\*\*/g, ''), CW);
        for(const ln of lines){
          if(y > PH - M - 12){ doc.addPage(); y = M + 4; }
          doc.text(ln, M, y); y += 5;
        }
        y += 4;
      };
      block('Ingrédients', r.ingredients);
      block('Préparation', r.preparation);

      if(btn && i % 10 === 0){
        btn.textContent = '⏳ ' + Math.round((i / all.length) * 100) + ' %';
        await new Promise(res=>setTimeout(res, 0));
      }
    }

    // ── Pied de page sur toutes les pages ──
    const total = doc.getNumberOfPages();
    for(let p = 1; p <= total; p++){
      doc.setPage(p);
      doc.setFont('helvetica', 'normal'); doc.setFontSize(7.5);
      doc.setTextColor(140, 150, 158);
      doc.text('Téléchargé par ' + who + ' le ' + dateFr, M, PH - 10);
      doc.text(p + ' / ' + total, PW - M, PH - 10, {align:'right'});
    }

    doc.save('Recettes_famille_Mignonne_' + now.getFullYear() + p2(now.getMonth()+1) + p2(now.getDate()) + '.pdf');
    toast('Livre PDF généré ✓');
  }catch(e){
    console.error('PDF error:', e);
    toast('Génération du PDF impossible — vérifiez votre connexion');
  }finally{
    if(btn){ btn.disabled = false; btn.textContent = old || '📄 Télécharger le livre en PDF'; }
  }
}


// ══════════════════════════════
// JOURNAL DES ERREURS
// Cloudflare mesure l'audience mais ne voit pas les erreurs JavaScript.
// On les consigne donc nous-memes, pour pouvoir les consulter a distance
// depuis l'onglet Infos plutot que de dependre de la console de chacun.
// ══════════════════════════════
let errLog = [];
const ERR_MAX = 30;
let lastErrWrite = 0;
let lastErrKey = '';

async function logError(msg, src, ligne){
  try{
    const cle = String(msg).slice(0,120) + '@' + ligne;
    const now = Date.now();
    // On evite les doublons rapproches : une erreur dans une boucle de rendu
    // peut se repeter des dizaines de fois par seconde.
    if(cle === lastErrKey && now - lastErrWrite < 30000) return;
    lastErrKey = cle; lastErrWrite = now;

    const nav = navigator.userAgent || '';
    const appareil = /Android/i.test(nav) ? 'Android'
                   : /iPhone|iPad/i.test(nav) ? 'iOS'
                   : /Mac/i.test(nav) ? 'Mac' : /Windows/i.test(nav) ? 'Windows' : 'autre';
    errLog.push({
      ts: now,
      v: APP_VERSION,
      qui: userName || '?',
      appareil: appareil,
      msg: String(msg).slice(0,200),
      ou: (String(src||'').split('/').pop() || '') + (ligne ? ':'+ligne : '')
    });
    if(errLog.length > ERR_MAX) errLog = errLog.slice(-ERR_MAX);
    const obj = {};
    errLog.forEach((e,i)=>{ obj['e_'+e.ts+'_'+i] = e; });
    await update(infosRef, { _pass: FAMILY_PASS, errors: obj });
  }catch(e){
    // Un echec d'enregistrement ne doit jamais aggraver la situation
    console.warn('logError:', e);
  }
}

window.addEventListener('error', (ev)=>{
  logError(ev.message || 'Erreur inconnue', ev.filename, ev.lineno);
});
window.addEventListener('unhandledrejection', (ev)=>{
  const r = ev.reason;
  logError('Promesse rejetee : ' + ((r && r.message) ? r.message : String(r)), '', 0);
});

function renderErrLog(){
  const c = document.getElementById('infosErrors');
  if(!c) return;
  if(!errLog.length){
    c.innerHTML = '<div class="err-none">Aucune erreur enregistrée. Tout va bien.</div>';
    return;
  }
  const p2 = n => String(n).padStart(2,'0');
  c.innerHTML = errLog.slice().reverse().map(e=>{
    const d = new Date(e.ts);
    return '<div class="err-row"><div class="err-head">'
      + '<span class="err-when">' + p2(d.getDate()) + '/' + p2(d.getMonth()+1) + ' ' + p2(d.getHours()) + ':' + p2(d.getMinutes()) + '</span>'
      + '<span class="err-v">' + escTxt(e.v||'?') + '</span>'
      + '<span class="err-who">' + escTxt(e.qui||'?') + ' · ' + escTxt(e.appareil||'?') + '</span>'
      + '</div><div class="err-msg">' + escTxt(e.msg||'') + '</div>'
      + (e.ou ? '<div class="err-loc">' + escTxt(e.ou) + '</div>' : '')
      + '</div>';
  }).join('');
}

async function clearErrLog(){
  if(!(await askConfirm("Effacer le journal des erreurs ?", {title:'Journal des erreurs', yes:'Effacer', danger:true}))) return;
  errLog = [];
  try{ await update(infosRef, { _pass: FAMILY_PASS, errors: null }); }catch(e){ console.warn(e); }
  renderErrLog();
  toast('Journal effacé');
}

