// Confirmation maison, retourne une Promise<boolean>
let confirmResolver = null;
function askConfirm(message, opts){
  opts = opts || {};
  return new Promise((resolve)=>{
    confirmResolver = resolve;
    document.getElementById('confirmTitle').textContent = opts.title || 'Confirmer';
    document.getElementById('confirmText').textContent = message;
    const yes = document.getElementById('confirmYes');
    yes.textContent = opts.yes || 'Confirmer';
    yes.className = 'btn ' + (opts.danger ? 'btn-danger' : 'btn-primary');
    document.getElementById('confirmNo').textContent = opts.no || 'Annuler';
    document.getElementById('modalConfirm').classList.add('show');
    setTimeout(()=>yes.focus(), 150);
  });
}
function resolveConfirm(v){
  document.getElementById('modalConfirm').classList.remove('show');
  if(confirmResolver){ const r = confirmResolver; confirmResolver = null; r(v); }
}
document.getElementById('confirmYes').addEventListener('click', ()=>resolveConfirm(true));
document.getElementById('confirmNo').addEventListener('click', ()=>resolveConfirm(false));
document.getElementById('modalConfirm').addEventListener('click', (e)=>{ if(e.target.id==='modalConfirm') resolveConfirm(false); });
document.addEventListener('keydown', (e)=>{
  if(e.key==='Escape'){
    if(document.getElementById('modalConfirm').classList.contains('show')) resolveConfirm(false);
    else document.querySelectorAll('.modal-backdrop.show').forEach(m=>m.classList.remove('show'));
  }
});

function addRecHist(id, act){
  const who = ensureUserName() || 'Anonyme';
  if(!Array.isArray(recHist[id])) recHist[id] = [];
  recHist[id].push({ ts: Date.now(), who: who, act: act });
  if(recHist[id].length > REC_HIST_MAX) recHist[id] = recHist[id].slice(-REC_HIST_MAX);
}

function recHistHtml(id){
  const h = recHist[id];
  if(!Array.isArray(h) || !h.length){
    return '<div class="rec-section-title">Historique</div><div class="rec-hist-empty">Aucune modification enregistrée pour l\'instant.</div>';
  }
  const p = n => String(n).padStart(2,'0');
  const rows = h.slice().reverse().slice(0,10).map(e=>{
    const d = new Date(e.ts);
    const date = p(d.getDate())+'/'+p(d.getMonth()+1)+'/'+d.getFullYear()+' à '+p(d.getHours())+':'+p(d.getMinutes());
    return '<div class="rec-hist-row"><span class="rec-hist-date">'+date+'</span>'
         + '<span class="rec-hist-who">'+escTxt(e.who||'?')+'</span>'
         + '<span class="rec-hist-act">'+escTxt(e.act||'')+'</span></div>';
  }).join('');
  return '<div class="rec-section-title">Historique</div><div class="rec-hist">'+rows+'</div>';
}

// ── Indicateur d'enregistrement ──
function setRecSaveState(state){
  const el = document.getElementById('recSaveState');
  if(!el) return;
  if(state==='wait'){ el.textContent='Enregistrement…'; el.className='rec-save-state wait'; }
  else if(state==='ok'){ el.textContent='Enregistré ✓'; el.className='rec-save-state ok'; }
  else if(state==='warn'){ el.textContent='Titre et préparation obligatoires'; el.className='rec-save-state warn'; }
  else { el.textContent=''; el.className='rec-save-state'; }
}

// ── Enregistrement automatique du texte (recettes famille) ──
function scheduleRecAutosave(){
  if(!recAutosave || !editingRecId) return;
  setRecSaveState('wait');
  clearTimeout(recAutosaveTimer);
  recAutosaveTimer = setTimeout(doRecAutosave, 900);
}
async function doRecAutosave(){
  if(!recAutosave || !editingRecId) return;
  const idx = recettes.findIndex(r=>r.id===editingRecId);
  if(idx < 0) return;
  const titre        = document.getElementById('frTitre').value.trim();
  const auteur       = document.getElementById('frAuteur').value.trim();
  const ingredients  = document.getElementById('frIngredients').value.trim();
  const preparation  = document.getElementById('frPreparation').value.trim();
  if(!titre || !preparation){ setRecSaveState('warn'); return; }
  const b = recettes[idx];
  const changed = [];
  if(b.titre !== titre) changed.push('titre');
  if((b.auteur||'') !== auteur) changed.push('auteur');
  if((b.ingredients||'') !== ingredients) changed.push('ingrédients');
  if((b.preparation||'') !== preparation) changed.push('préparation');
  if(!changed.length){ setRecSaveState('ok'); return; }
  recettes[idx] = { ...b, titre, auteur, ingredients, preparation, updatedAt: new Date().toISOString() };
  addRecHist(editingRecId, 'Modification : ' + changed.join(', '));
  await saveRecettes();
  setRecSaveState('ok');
  renderRecettes();
}

// ── Enregistrement immediat des photos ──
async function persistPhotosNow(act){
  if(editingCollectorId){
    if(recPhotosBuffer.length) collectorPhotos[editingCollectorId] = [...recPhotosBuffer];
    else delete collectorPhotos[editingCollectorId];
    addRecHist(editingCollectorId, act);
    await saveCollectorPhotos();
    await saveRecettes();
  } else if(editingRecId){
    const idx = recettes.findIndex(r=>r.id===editingRecId);
    if(idx < 0) return;
    recettes[idx] = { ...recettes[idx], photos:[...recPhotosBuffer], updatedAt:new Date().toISOString() };
    addRecHist(editingRecId, act);
    await saveRecettes();
  } else {
    return; // creation en cours : rien a persister tant que la recette n'existe pas
  }
  renderRecettes();
  setRecSaveState('ok');
}

