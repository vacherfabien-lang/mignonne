// Index stable des prénoms (pour alternance de 2 couleurs)

// Une couleur par séjour, tirée de son identifiant. Le tirage paraît
// aléatoire mais reste STABLE : un séjour garde sa couleur d'une session à
// l'autre et sur tous les appareils. Les répétitions sont assumées.
function bandColor(booking){
  const s = String(booking.id || booking.start || '');
  let h = 0;
  for(let i=0;i<s.length;i++){ h = ((h<<5)-h) + s.charCodeAt(i); h |= 0; }
  return PAL[Math.abs(h) % PAL.length];
}

function drawBands(gridEl,overlay,monthIdx,daysInMonth,firstWeekday,year){
  overlay.innerHTML='';

  const allCells=[...gridEl.children];
  if(!allCells.length)return;

  const jourCell=allCells.find(el=>!el.classList.contains('empty'));
  if(!jourCell)return;

  const cellW=jourCell.offsetWidth;
  const cellH=jourCell.offsetHeight;
  // Hauteur de bande adaptée à la taille de cellule (≈ 45% de cellH pour avoir un look propre)
  const isBig=gridEl.classList.contains('big');
  // Vue Mois : 24px fixe (cellules 60-70px). Vue Année : ≈45% de la hauteur de cellule (entre 13 et 18px selon écran).
  const bandH = isBig ? 24 : Math.max(13, Math.min(18, Math.round(cellH*0.45)));

  // Pour chaque séjour qui intersecte ce mois
  const yr = year !== undefined ? year : curYearView;
  const monthStart=new Date(yr,monthIdx,1);
  const monthEnd=new Date(yr,monthIdx+1,0);
  const monthStartIso=d2i(monthStart);
  const nextMonthIso=addD(d2i(monthEnd),1);

  // Filtrer les séjours qui intersectent ce mois.
  // Note : la cellule du jour de départ (b.end) est aussi visuellement occupée
  // (départ et arrivée du suivant peuvent se chevaucher)
  const bkInMonth=bookings.filter(b=>b.start<nextMonthIso && addD(b.end,1)>monthStartIso);

  // Calculer un "slot" vertical pour chaque séjour : si un séjour commence là où un autre
  // finit (b2.start === b1.end), il faut les décaler pour qu'ils restent visibles.
  // Slot 0 = bas (défaut), slot 1 = haut. On répète si plus de 2 chevauchements (rare).
  const sortedBk=[...bkInMonth].sort((a,b)=>a.start.localeCompare(b.start));
  const slots={}; // bookingId -> slotIdx
  sortedBk.forEach(b=>{
    // Cherche un slot libre (pas de chevauchement visuel avec un autre séjour déjà placé)
    // Chevauchement visuel : un séjour b1 occupe [b1.start, b1.end+1[ inclusivement
    let slot=0;
    for(;;){
      const conflict=sortedBk.find(other=>{
        if(other===b||slots[other.id]!==slot)return false;
        const aS=b.start,aE=addD(b.end,1);
        const oS=other.start,oE=addD(other.end,1);
        return aS<oE && oS<aE;
      });
      if(!conflict)break;
      slot++;
    }
    slots[b.id]=slot;
  });

  bkInMonth.forEach(b=>{
    // Étendre visuellement jusqu'à b.end+1 pour inclure la cellule du jour de départ
    const visualEnd=addD(b.end,1);
    const visStart=b.start<monthStartIso?monthStartIso:b.start;
    const visEnd=visualEnd>nextMonthIso?nextMonthIso:visualEnd;
    const continuesLeft=b.start<monthStartIso;
    const continuesRight=visualEnd>nextMonthIso;
    const slot=slots[b.id]||0;

    let c=visStart;
    while(c<visEnd){
      // Trouver la cellule de `c` dans allCells
      const cell=allCells.find(el=>el.dataset && el.dataset.iso===c);
      if(!cell)break;

      const dateC=new Date(c+'T00:00');
      let dow=dateC.getDay();dow=dow===0?6:dow-1;
      const daysUntilEndOfWeek=6-dow;
      let bandEndIso=addD(c,daysUntilEndOfWeek+1);
      if(bandEndIso>visEnd)bandEndIso=visEnd;

      // Position de la cellule de départ dans la grille
      const startIdx=allCells.indexOf(cell);
      const row=Math.floor(startIdx/7);
      const col=startIdx%7;
      const spanDays=Math.round((new Date(bandEndIso+'T00:00')-new Date(c+'T00:00'))/86400000);

      // Géométrie : décalage vertical selon le slot pour les chevauchements.
      // Toutes les bandes ont la MÊME hauteur (visuellement plus propre, même si
      // une bande slot 1 dépasse légèrement vers la cellule du dessus).
      const left=col*cellW+2;
      const width=spanDays*cellW-4;
      const slotGap=2;
      // Slot 0 (bas) : bande en bas. Slot 1+ : empilée au-dessus à la même hauteur.
      const top=row*cellH + cellH - bandH - 2 - slot*(bandH+slotGap);

      const band=document.createElement('div');
      band.className='cal-band';
      band.style.left=left+'px';
      band.style.width=width+'px';
      band.style.top=top+'px';
      band.style.height=bandH+'px';
      band.style.background=bandColor(b);

      const isBandFirst=c===visStart;
      const isBandLast=bandEndIso===visEnd;
      // Chaque bande (sauf la première du séjour) "continue à gauche"
      if(!isBandFirst||continuesLeft)band.classList.add('cal-band-continues-left');
      if(!isBandLast||continuesRight)band.classList.add('cal-band-continues-right');

      band.textContent=shortN(bkLabel(b));
      band.title=`${bkLabel(b)} · ${fmtS(b.start)} → ${fmtS(b.end)}`;
      band.addEventListener('click',e=>{e.stopPropagation();openEdit(b)});

      overlay.appendChild(band);

      c=bandEndIso;
    }
  });
}

