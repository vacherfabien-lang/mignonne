<body>

<!-- VOLETS DE CHARGEMENT : le temps que les données arrivent, la fenêtre de la
     maison est fermée ; elle s'ouvre dès que les séjours sont chargés.
     Sa fermeture ne dépend PAS du script principal : un minuteur de secours
     ouvre les volets quoi qu'il arrive, pour ne jamais bloquer l'application. -->
<div id="volets" class="volets" aria-hidden="true">
  <div class="baie" id="baie">
    <div class="baie-dedans"><div><svg class="plaque" viewBox="8 5 362 218" role="img" aria-label="Mignonne"><use href="#plaqueMignonne"/></svg><small>Chargement…</small></div></div>
    <div class="volet g"></div><div class="volet d"></div>
    <div class="appui"></div>
  </div>
</div>
<script>
(function(){
  var fait = false;
  window.ouvrirVolets = function(){
    if(fait) return; fait = true;
    var v = document.getElementById('volets'), b = document.getElementById('baie');
    if(!v) return;
    if(b) b.classList.add('ouverte');
    setTimeout(function(){ v.classList.add('fini'); }, 650);
    setTimeout(function(){ if(v.parentNode) v.parentNode.removeChild(v); }, 1300);
  };
  // Secours : quoi qu'il arrive au chargement, on ne bloque jamais l'écran.
  setTimeout(window.ouvrirVolets, 8000);
})();
</script>

<header class="sticky-header" id="stickyHeader">
  <div class="header-top">
    <h1 class="title-plaque"><svg class="plaque" viewBox="8 5 362 218" role="img" aria-label="Mignonne"><use href="#plaqueMignonne"/></svg></h1>
    <div class="plaque-ville">Saint-Malo</div>
  </div>
  <!-- Onglets principaux -->
  <nav class="tabs tabs-main" role="tablist" aria-label="Sections">
    <button class="tab-main active" data-section="resa">Réservations</button>
    <button class="tab-main" data-section="rec" aria-label="Recettes de famille">Recettes<span class="tab-long"> de famille</span></button>
    <button class="tab-main" data-section="plans">Bons plans</button>
    <button class="tab-main" data-section="infos">Infos</button>
  </nav>
  <!-- Sous-onglets de Réservations -->
  <nav class="tabs tabs-sub" id="subtabs-resa" role="tablist" aria-label="Vues des réservations">
    <button class="tab active" data-view="year">Année</button>
    <button class="tab" data-view="month">Mois</button>
    <button class="tab" data-view="list">Liste</button>
    <button class="tab" data-view="history">Historique</button>
    <button class="tab" data-view="stats">Statistiques</button>
  </nav>
</header>

<div id="resaTools">
  <div class="select-hint" id="selectHint">
    <span class="sh-step" id="shStep">1/2</span>
    <span class="sh-msg" id="shMsg">Cliquez sur la date d'arrivée</span>
    <button class="sh-cancel" onclick="cancelSel()">Annuler</button>
  </div>

  <div class="toolbar">
    <button class="btn-add" onclick="startNew()"><span class="plus">+</span> Nouveau séjour</button>
    <button class="btn-export" id="btnExport" onclick="exportAllData()" title="Télécharger une sauvegarde complète de toutes les données">💾 Exporter les données</button>
    <div class="status" id="status">Chargement…</div>
  </div>

  <!-- Toggles affichage : visibles uniquement en vue Année et vue Mois -->
  <div class="display-toggles" id="displayToggles">
    <button class="toggle-btn ferie" id="btnFerie" onclick="toggleFerie()">
      <span class="tbdot" style="background:var(--ferie-dot)"></span> Jours fériés
    </button>
    <button class="toggle-btn vac" id="btnVac" onclick="toggleVac()">
      <span class="tbdot" style="background:var(--vac-dot)"></span> Vacances scolaires
    </button>
    <button class="toggle-btn maree" id="btnMaree" onclick="toggleMaree()">
      <span class="tbdot" style="background:var(--tide-dot)"></span> Marées
    </button>
    <select class="zone-select" id="zoneSelect" onchange="changeZone(this.value)">
