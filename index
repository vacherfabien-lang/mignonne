<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Mignonne — Saint-Malo</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%231f4e86'/%3E%3Cpath d='M6 27V15L16 4l10 11v12z' fill='%23fbfbf8'/%3E%3Cpath d='M13 20v-4.5a3 3 0 0 1 6 0V20z' fill='%231f4e86'/%3E%3Cpath d='M11.5 21.5h9' stroke='%231f4e86' stroke-width='1.8' stroke-linecap='round'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&family=Inter:wght@400;500;600;700&family=Signika:wght@300..700&display=swap" rel="stylesheet">
<style>
:root{
  /* Palette tirée de la façade de la maison (photos de septembre 2026).
     --sand = l'enduit blanc, --sand-light = le blanc des volets,
     --stone = les encadrements, --ocean = le bleu de la plaque et des
     garde-corps. Le corail ne sert plus qu'aux alertes. */
  --sand:#f6f6f2;--sand-light:#ffffff;--stone:#e7dcc8;--stone-strong:#cdbd9f;
  --ink:#1d2b36;--ink-soft:#3a4a56;--slate:#5d6461;
  --ocean:#1f4e86;--ocean-deep:#173d69;--coral:#c4533b;
  --line:rgba(29,43,54,.12);--line-strong:rgba(29,43,54,.22);
  --ferie-bg:rgba(31,78,134,.07);--ferie-dot:#1f4e86;
  --vac-bg:rgba(205,189,159,.20);--vac-dot:#b89f78;
  /* Marées Saint-Malo : 5 paliers du bleu sable au corail intense */
  --tide-1:rgba(232,221,200,.45);  /* 20-44 mortes-eaux */
  --tide-2:rgba(199,213,219,.55);  /* 45-69 marées moyennes */
  --tide-3:rgba(140,178,193,.55);  /* 70-94 vives-eaux */
  --tide-4:rgba(214,138,113,.55);  /* 95-104 grandes marées */
  --tide-5:rgba(200,85,61,.65);    /* ≥105 très grandes marées */
  --tide-dot:#5a8ba0;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{overflow-x:hidden}
body{font-family:'Inter',system-ui,sans-serif;background:var(--sand);color:var(--ink);line-height:1.5;min-height:100vh;
  background-image:none;
  padding-top:env(safe-area-inset-top)}

/* ── STICKY HEADER ── */
.sticky-header{position:sticky;top:0;z-index:50;background:var(--sand-light);border-bottom:1px solid var(--line);transition:box-shadow .2s}
/* La plaque de la façade. L'en-tête reste collé en haut de l'écran : la plaque
   est dimensionnée comme l'ancien titre, et rétrécit quand on fait défiler. */
.title-plaque{margin:0;line-height:0}
.title-plaque .plaque{width:240px;height:auto;display:block;margin:0 auto;transition:width .25s ease}
.plq-t{font-family:'Signika',sans-serif;font-weight:440;font-size:58px}
.plaque-ville{font-family:'Fraunces',serif;font-style:italic;font-size:.82rem;color:var(--slate);margin-top:.1rem;transition:opacity .2s,height .2s}
.sticky-header.scrolled .title-plaque .plaque{width:128px}
.sticky-header.scrolled .plaque-ville{opacity:0;height:0;overflow:hidden;margin:0}
.sticky-header.scrolled{box-shadow:0 2px 12px rgba(29,43,54,.08)}
.header-top{padding:1rem 1rem .4rem;max-width:1200px;margin:0 auto;text-align:center}
.subtitle{font-size:.62rem;letter-spacing:.28em;text-transform:uppercase;color:var(--slate);font-weight:500}
.title{font-family:'Fraunces',serif;font-weight:400;font-size:clamp(1.9rem,6.5vw,3rem);letter-spacing:-.02em;color:var(--ink);font-style:italic;line-height:1;margin-top:.3rem}

/* ── ONGLETS ── */
.tabs{display:flex;justify-content:center;max-width:1200px;margin:.5rem auto 0;padding:0 1rem;border-top:1px solid var(--line)}
.tab{background:none;border:none;padding:.55rem .4rem;font-size:.78rem;font-weight:500;color:var(--slate);cursor:pointer;position:relative;flex:1;max-width:130px;font-family:'Inter',sans-serif;white-space:nowrap}
.tab.active{color:var(--ocean-deep)}
.tab.active::after{content:'';position:absolute;bottom:-1px;left:15%;right:15%;height:2px;background:var(--ocean)}

/* Onglets principaux (gros) : Réservations / Recettes */
.tabs-main{
  border-top:none;
  margin-top:.7rem;
  padding-bottom:.1rem;
  gap:.4rem;
}
.tab-main{
  background:none;border:none;cursor:pointer;
  font-family:'Fraunces',serif;font-style:italic;
  font-size:1rem;font-weight:500;
  padding:.45rem .9rem .6rem;
  color:var(--slate);
  position:relative;
  white-space:nowrap;
  transition:color .15s;
}
.tab-main:active{transform:scale(.97)}
/* L'onglet actif est souligné comme les fenêtres de la maison :
   par une barre d'appui bleue. */
.tab-main.active{color:var(--ocean)}
.tab-main.active::after{content:'';position:absolute;left:.6rem;right:.6rem;bottom:0;height:3px;border-radius:2px;background:var(--ocean)}

/* Sous-onglets : visibles uniquement quand la section parente est active */
.tabs-sub{display:none;margin-top:.4rem}
.tabs-sub.show{display:flex}

/* ── TOOLBAR ── */
.toolbar{max-width:1200px;margin:.75rem auto 0;padding:0 1rem;display:flex;justify-content:space-between;align-items:center;gap:.5rem;flex-wrap:wrap}
.btn-add{background:var(--ocean);color:var(--sand-light);border:none;padding:.6rem 1.1rem;font-size:.82rem;font-weight:500;cursor:pointer;border-radius:3px;display:inline-flex;align-items:center;gap:.45rem;font-family:'Inter',sans-serif}
.btn-add:active{background:var(--ocean-deep)}
.btn-add .plus{font-size:1rem;line-height:1}
.status{font-size:.72rem;color:var(--slate);font-style:italic}
.btn-export{background:none;color:var(--ocean);border:1px solid var(--ocean);padding:.5rem .9rem;font-size:.75rem;font-weight:500;cursor:pointer;border-radius:3px;display:inline-flex;align-items:center;gap:.4rem;font-family:'Inter',sans-serif}
.btn-export:active{background:var(--ocean);color:white}
.btn-export[disabled]{opacity:.5;cursor:wait}
@media(max-width:900px){.btn-export{font-size:.7rem;padding:.45rem .7rem}}

/* Toggles jours fériés / vacances */
.display-toggles{display:flex;gap:.4rem;flex-wrap:wrap;padding:.4rem 1rem;max-width:1200px;margin:0 auto}
.toggle-btn{background:none;border:1px solid var(--line-strong);padding:.22rem .7rem;border-radius:100px;font-size:.68rem;cursor:pointer;color:var(--ink-soft);font-family:'Inter',sans-serif;font-weight:500;display:inline-flex;align-items:center;gap:.3rem;transition:all .15s}
.toggle-btn .tbdot{width:7px;height:7px;border-radius:50%;display:inline-block}
.toggle-btn.on{color:var(--ink);border-color:var(--ink)}
.toggle-btn.on.ferie{background:rgba(31,78,134,.08);border-color:var(--ocean);color:var(--ocean)}
.toggle-btn.on.vac{background:rgba(45,95,124,.1);border-color:var(--ocean);color:var(--ocean)}
.toggle-btn.on.maree{background:rgba(90,139,160,.12);border-color:var(--tide-dot);color:var(--tide-dot)}
.zone-select{background:var(--sand-light);border:1px solid var(--line-strong);padding:.22rem .55rem;border-radius:100px;font-size:.68rem;font-family:'Inter',sans-serif;color:var(--ink-soft);cursor:pointer;display:none}
.zone-select.show{display:inline-block}

/* ── BANDEAU DE SÉLECTION (sticky, étapes 1/2 et 2/2) : un guide, pas une alerte ── */
.select-hint{
  position:sticky;top:0;z-index:60;
  background:var(--ocean);color:white;
  display:none;align-items:center;justify-content:space-between;gap:.6rem;
  padding:.55rem .9rem;font-family:'Inter',sans-serif;
  box-shadow:0 2px 10px rgba(31,78,134,.35);
  animation:slideDown .25s ease;
}
.select-hint.show{display:flex}
.select-hint .sh-step{
  background:rgba(255,255,255,.22);color:white;
  font-size:.62rem;font-weight:700;letter-spacing:.08em;
  padding:.18rem .55rem;border-radius:100px;flex-shrink:0;
}
.select-hint .sh-msg{
  flex:1;font-family:'Fraunces',serif;font-style:italic;
  font-size:.92rem;line-height:1.2;
}
.select-hint .sh-msg .sh-date{
  display:inline-block;background:rgba(255,255,255,.95);color:var(--ocean);
  font-family:'Inter',sans-serif;font-style:normal;font-weight:600;
  padding:.05rem .4rem;border-radius:3px;margin-left:.3rem;font-size:.82rem;
}
.select-hint .sh-cancel{
  background:rgba(0,0,0,.18);color:white;border:none;
  padding:.32rem .75rem;border-radius:3px;font-size:.72rem;font-weight:600;
  cursor:pointer;font-family:'Inter',sans-serif;flex-shrink:0;
}
.select-hint .sh-cancel:active{background:rgba(0,0,0,.32)}
@keyframes slideDown{from{transform:translateY(-100%)}to{transform:translateY(0)}}

/* ── CELLULE ARRIVÉE : la classe is-arrival est posée par le JS pour pouvoir
   être stylée ultérieurement si besoin, mais on ne lui applique aucun fond
   particulier — la bande horizontale du séjour suffit à indiquer le début. ── */

/* ── VUES ── */
.view{max-width:1200px;margin:.8rem auto;padding:0 .75rem 4rem;display:none}
.view.active{display:block}

/* ══════════════════════
   VUE ANNÉE — cellules uniformes, bandes de séjour en overlay
   ══════════════════════ */
.year-nav{display:flex;justify-content:center;align-items:center;gap:1rem;margin-bottom:.75rem}
.nav-btn{background:none;border:1px solid var(--line-strong);width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:1.05rem;color:var(--ink-soft);display:flex;align-items:center;justify-content:center}
.nav-btn:active{background:var(--ink);color:var(--sand)}
.year-lbl{font-family:'Fraunces',serif;font-size:1.3rem;font-weight:500;font-style:italic;min-width:80px;text-align:center}
.year-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem}
.month-card{background:var(--sand-light);border:1px solid var(--line);border-radius:5px;overflow:hidden}
.month-header{display:flex;justify-content:space-between;align-items:baseline;padding:.5rem .7rem .35rem;background:var(--stone);border-bottom:1px solid var(--line-strong)}
.month-name-lbl{font-family:'Fraunces',serif;font-size:.95rem;font-weight:500;color:var(--ink);text-transform:capitalize}
.month-nights{font-size:.63rem;color:var(--slate);font-style:italic;font-family:'Fraunces',serif}

/* Wrapper qui contient grille + overlay des bandes */
.cal-wrap{position:relative}

/* En-tête de calendrier (jours de la semaine) — hors grille pour éviter conflit */
.cal-head{
  display:grid;
  grid-template-columns:repeat(7,1fr);
  background:var(--stone);
  border-bottom:1px solid var(--line-strong);
}
.cal-head-cell{
  font-size:.62rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
  color:var(--slate);text-align:center;
  padding:.3rem .1rem;
  border-right:1px solid var(--line);
}
.cal-head-cell:last-child{border-right:none}

/* Conteneur relatif autour de la grille pour l'overlay */
.cal-body-wrap{position:relative}

/* Grille des jours — toutes cellules 38px identiques */
.cal-grid{
  display:grid;
  grid-template-columns:repeat(7,1fr);
  grid-auto-rows:38px;
  gap:0;
  position:relative;
}

/* Variante "grande" pour vue Mois : plus de place, cellules 70px */
.cal-grid.big{
  grid-auto-rows:70px;
}
.cal-grid.big + .cal-bands .cal-band{
  height:24px;
  font-size:.78rem;
}
.cal-grid.big ~ .cal-bands .cal-band{
  height:24px;
  font-size:.78rem;
}
/* Numéro plus grand en vue Mois : c'est l'information principale de la
   case, il doit dominer visuellement la pastille de marée. */
.cal-grid.big .day-num-sm{
  font-size:.92rem;
  font-weight:600;
  opacity:1;
  color:var(--ink);
}
.cal-grid.big .cal-cell{padding:5px 7px}

/* Label du jour férié (visible uniquement en vue Mois grâce à la taille) */
.ferie-lbl{
  display:block;
  font-size:.58rem;
  color:var(--ocean);
  font-style:italic;
  font-weight:400;
  margin-top:2px;
  line-height:1.1;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.cal-grid:not(.big) .ferie-lbl{display:none} /* masquer en mini */

/* Cellule jour : propre, numéro en haut à gauche, fond uniforme */
.cal-cell{
  position:relative;
  background:white;
  cursor:pointer;user-select:none;
  border-right:1px solid var(--line);
  border-bottom:1px solid var(--line);
  padding:3px 5px;
}
.cal-cell:nth-child(7n){border-right:none}
.cal-cell.empty{background:rgba(0,0,0,.02);cursor:default;pointer-events:none}
.cal-cell.is-ferie{background:var(--ferie-bg)}
.cal-cell.is-vac{background:var(--vac-bg)}
.cal-cell.is-ferie.is-vac{background:linear-gradient(135deg,var(--ferie-bg) 50%,var(--vac-bg) 50%)}

/* Marées : 5 paliers de bg, prennent le pas sur fériés/vacances quand actifs */
/* Marées : jauge fine en bas de cellule. Les fonds colorés restent
   réservés aux vacances scolaires et jours fériés, pour éviter que
   trois systèmes de couleur se superposent. */
/* Marées : la mer monte DANS la cellule. Le remplissage occupe toute la
   largeur, comme une ligne d'eau, et sa ligne de crête dessine la houle
   d'un jour à l'autre. Il passe sous les bandeaux de séjour, qui restent
   lisibles, et ne dispute plus le bas de la cellule à personne. */
.cal-cell .tide-wrap{position:absolute;inset:0;pointer-events:none;z-index:0}
.cal-cell .tide-svg{display:block;width:100%;height:100%}
/* La crête garde une épaisseur constante malgré l'étirement du viewBox */
.tide-crest{
  fill:none;stroke:rgba(76,125,165,.75);stroke-width:2;
  vector-effect:non-scaling-stroke;stroke-linecap:square;
}
.tide-crest.fort{stroke:rgba(31,78,134,.95);stroke-width:2.5}
/* Le contenu de la case doit rester au-dessus de l'eau */
.cal-cell .day-num-sm{position:relative;z-index:1}
/* Coefficient : présenté en PASTILLE et non en nombre nu. Sans cela, deux
   nombres de taille voisine cohabitent en haut de la case et l'œil ne sait
   plus lequel est la date. La forme arrondie, le fond plein et la taille
   réduite le distinguent immédiatement du numéro du jour. */
.cal-cell .tide-num{
  position:absolute;top:4px;right:4px;z-index:2;
  font-family:'Inter',sans-serif;font-size:.56rem;font-weight:700;
  background:#45739e;color:#fff;
  padding:1px 4px 2px;border-radius:100px;
  line-height:1.15;pointer-events:none;letter-spacing:0;
}
.cal-cell .tide-num.fort{background:#2b5a8a}
/* Vue Année : cellules trop petites pour du texte, on garde la houle seule */
.cal-grid:not(.big) .cal-cell .tide-num{display:none}




.cal-cell.today .day-num-sm{color:var(--ocean);font-weight:800}

/* Numéro petit, en haut à gauche, discret */
.day-num-sm{
  font-size:.68rem;
  color:var(--ink-soft);
  line-height:1;
  font-weight:500;
  opacity:1;
  pointer-events:none;
}
.day-num-sm.ferie-mark{color:var(--ocean);font-weight:700;opacity:1}

/* OVERLAY : les bandes de séjours, positionnées par-dessus la grille */
.cal-bands{
  position:absolute;
  inset:0;
  pointer-events:none;
}
.cal-band{
  position:absolute;
  height:20px;
  border-radius:3px;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:0 6px;
  color:var(--ink);
  font-size:.72rem;
  font-weight:600;
  letter-spacing:.01em;
  pointer-events:auto;
  cursor:pointer;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  /* Les teintes sont claires : un liseré fin les détache du fond sable. */
  border:1px solid rgba(29,43,54,.16);
  box-shadow:0 1px 2px rgba(0,0,0,.06);
  transition:transform .1s ease, box-shadow .1s ease;
}
.cal-band:hover{transform:translateY(-1px);box-shadow:0 2px 5px rgba(0,0,0,.12)}
.cal-band-continues-left{border-top-left-radius:0;border-bottom-left-radius:0}
.cal-band-continues-right{border-top-right-radius:0;border-bottom-right-radius:0}

/* Sélection visuelle */
.cal-cell.sel-start,.cal-cell.sel-end-hover{background:rgba(31,78,134,.15)!important}
.cal-cell.sel-range{background:rgba(31,78,134,.08)!important}

/* ── VUE MOIS ── */
.month-nav{display:flex;justify-content:center;align-items:center;gap:1rem;margin-bottom:1rem}
.current-month{font-family:'Fraunces',serif;font-size:1.25rem;font-weight:500;font-style:italic;min-width:200px;text-align:center;text-transform:capitalize}
.big-cal{background:var(--sand-light);border:1px solid var(--line);border-radius:4px;overflow:hidden}
.big-cal-head{display:grid;grid-template-columns:repeat(7,1fr);background:var(--stone)}
.big-cal-head div{padding:.42rem .2rem;text-align:center;font-size:.63rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);font-weight:600}
.big-cal-body{display:grid;grid-template-columns:repeat(7,1fr)}
.big-day{min-height:62px;padding:.28rem .28rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line);cursor:pointer;user-select:none;position:relative;background:white}
.big-day.empty{background:rgba(0,0,0,.015);cursor:default;pointer-events:none}
.big-day:nth-child(7n){border-right:none}
.big-day.is-ferie{background:var(--ferie-bg)}
.big-day.is-vac{background:var(--vac-bg)}
.big-day-num{font-size:.76rem;color:var(--ink-soft);font-weight:500;display:flex;align-items:center;gap:3px}
.big-day-num .ferie-name{font-size:.58rem;color:var(--ocean);font-style:italic;font-weight:400;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:70px}
.big-day.today .big-day-num{color:var(--ocean);font-weight:700}
.big-day-booking{margin-top:3px;font-size:.62rem;padding:2px 5px;border-radius:2px;color:white;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.big-day.sel-start,.big-day.sel-end-hover{background:rgba(31,78,134,.15)!important}
.big-day.sel-range{background:rgba(31,78,134,.08)!important}
.legend{margin-top:1rem;padding:.8rem 1rem;background:var(--sand-light);border:1px solid var(--line);border-radius:4px}
.legend-title{font-family:'Fraunces',serif;font-size:.82rem;font-style:italic;color:var(--ink);margin-bottom:.45rem}
.legend-items{display:flex;flex-wrap:wrap;gap:.4rem .7rem}
.legend-item{display:flex;align-items:center;gap:.35rem;font-size:.72rem;color:var(--ink-soft)}
.legend-dot{width:11px;height:11px;border-radius:2px}

/* ── LISTE ── */
/* Une seule ligne défilante : avec une vingtaine de noms, le retour à la
   ligne occupait trois rangées et écrasait la liste elle-même. */
.filter-bar{margin-bottom:.7rem;display:flex;gap:.35rem;align-items:center;
  overflow-x:auto;padding-bottom:.3rem;scrollbar-width:thin}
.filter-bar::-webkit-scrollbar{height:4px}
.filter-bar::-webkit-scrollbar-thumb{background:var(--stone);border-radius:100px}
.filter-bar > *{flex-shrink:0}
.filter-label{font-size:.63rem;color:var(--slate);letter-spacing:.12em;text-transform:uppercase;margin-right:.2rem;font-weight:600}
.chip{background:var(--sand-light);border:1px solid var(--line-strong);padding:.22rem .65rem;border-radius:100px;font-size:.7rem;cursor:pointer;color:var(--ink-soft);display:inline-flex;align-items:center;gap:.3rem;font-family:'Inter',sans-serif}
.chip .dot{width:6px;height:6px;border-radius:50%}
.chip.active{background:var(--ink);color:var(--sand-light);border-color:var(--ink)}
.list-yr-head{font-family:'Fraunces',serif;font-size:.82rem;font-style:italic;color:var(--slate);margin:1rem 0 .4rem;padding-left:.2rem}
.list-yr-head:first-child{margin-top:.2rem}
/* Une seule structure, sur mobile comme sur ordinateur : le nom en tête,
   puis dates, nuits et réservataire sur une même ligne secondaire. */
.list-booking{background:var(--sand-light);border:1px solid var(--line);border-left:4px solid;border-radius:3px;padding:.6rem .85rem;margin-bottom:.35rem;display:flex;align-items:flex-start;gap:.6rem;cursor:pointer}
.list-booking.past{opacity:.52}
.list-booking.current{background:linear-gradient(90deg,rgba(31,78,134,.08),rgba(31,78,134,.03));border-color:var(--ocean);box-shadow:0 0 0 1px rgba(31,78,134,.15)}
.list-current-badge{display:inline-block;background:var(--ocean);color:white;font-size:.62rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:.15rem .5rem;border-radius:100px;margin-bottom:.3rem;font-family:'Inter',sans-serif}
.list-info{min-width:0;flex:1}
.list-name{font-weight:600;font-size:.95rem;color:var(--ink);line-height:1.3}
/* Dates, durée et réservataire tiennent sur une seule ligne secondaire,
   séparés par des points médians. */
.list-when{display:flex;flex-wrap:wrap;align-items:baseline;gap:.15rem .45rem;margin-top:.1rem}
.list-when > span + span::before{content:'·';color:var(--stone);margin-right:.45rem}
.list-date-range{font-size:.78rem;color:var(--ink-soft);font-weight:500;white-space:nowrap}
.list-nights{font-size:.75rem;color:var(--slate);white-space:nowrap}
.list-meta{font-size:.75rem;color:var(--slate)}
.list-comment{font-size:.76rem;color:var(--ink-soft);margin-top:.25rem;font-style:italic;line-height:1.4}
.list-edit{font-size:.95rem;color:var(--slate);opacity:.55;padding:.1rem .2rem;flex-shrink:0}
.list-booking:hover .list-edit{opacity:1;color:var(--ocean)}
.empty-state{text-align:center;padding:2.5rem 1rem;color:var(--slate)}

/* ── HISTORIQUE ── */
/* Liste continue plutôt qu'une succession d'encadrés : la date passe en
   en-tête de journée, chaque ligne ne porte plus que son heure. */
.hist-day{font-family:'Fraunces',serif;font-style:italic;font-size:.85rem;color:var(--slate);
  margin:1.1rem 0 .3rem;padding-bottom:.25rem;border-bottom:1px solid var(--stone)}
.hist-day:first-child{margin-top:.2rem}
.hist-row{display:flex;gap:.7rem;padding:.5rem .2rem;border-bottom:1px solid rgba(29,43,54,.06)}
.hist-row:last-child{border-bottom:none}
.hist-hour{font-size:.72rem;color:var(--slate);font-variant-numeric:tabular-nums;
  flex-shrink:0;padding-top:.1rem;min-width:2.6rem}
.hist-main{min-width:0;flex:1}
.hist-line{font-size:.82rem;color:var(--ink);line-height:1.5}
.hist-dates{color:var(--ink-soft)}
.hist-dates::before{content:'·';color:var(--stone);margin:0 .35rem}
.hist-soft{color:var(--slate)}
.hist-soft::before{content:'·';color:var(--stone);margin:0 .35rem}
.hist-prev{font-size:.74rem;color:var(--slate);font-style:italic;margin-top:.1rem}
.hist-tag{display:inline-block;padding:.08rem .4rem;border-radius:100px;color:white;
  font-size:.62rem;font-weight:700;margin-right:.35rem;vertical-align:.06em;letter-spacing:.02em}
.hist-tag.add{background:#5b7553}
.hist-tag.mod{background:#8b6f47}
.hist-tag.del{background:#c8553d}

/* ── STATS ONGLET ── */
.stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1.5rem}
.stats-year-block{background:var(--sand-light);border:1px solid var(--line);border-radius:5px;padding:1.1rem 1rem}
.stats-year-title{font-family:'Fraunces',serif;font-size:1.3rem;font-style:italic;color:var(--ocean-deep);margin-bottom:.8rem;text-align:center}
.stat-row{display:flex;justify-content:space-between;align-items:baseline;padding:.4rem 0;border-bottom:1px solid var(--line)}
.stat-row:last-child{border-bottom:none}
.stat-row-label{font-size:.75rem;color:var(--ink-soft)}
.stat-row-val{font-family:'Fraunces',serif;font-size:1.2rem;font-weight:500;color:var(--ink)}
.stat-row-val.record{color:var(--ocean)}
.stats-people{margin-top:1rem}
.stats-people-title{font-family:'Fraunces',serif;font-size:.85rem;font-style:italic;color:var(--ink);margin-bottom:.6rem}
.people-row{display:flex;align-items:center;gap:.6rem;margin-bottom:.35rem}
.people-bar-wrap{flex:1;background:var(--stone);border-radius:100px;height:8px;overflow:hidden}
.people-bar{height:100%;border-radius:100px;transition:width .4s ease}
.people-label{font-size:.7rem;color:var(--ink-soft);min-width:90px}
.people-val{font-size:.72rem;color:var(--slate);min-width:50px;text-align:right}

/* ── BOUTON INFO ZONES + MODAL ZONES ── */
.zone-info-btn{
  background:var(--sand-light);
  border:1px solid var(--line-strong);
  color:var(--ocean);
  width:24px;height:24px;border-radius:50%;
  font-size:.85rem;cursor:pointer;
  display:inline-flex;align-items:center;justify-content:center;
  font-family:'Fraunces',serif;font-style:italic;
  padding:0;line-height:1;
  transition:all .15s;
}
.zone-info-btn:active{background:var(--ocean);color:white}
.modal-zones .zone-card{
  background:var(--sand);
  border:1px solid var(--line);
  border-left:4px solid;
  border-radius:4px;
  padding:.7rem .9rem;
  margin-bottom:.55rem;
}
.modal-zones .zone-card.zA{border-left-color:#c8553d}
.modal-zones .zone-card.zB{border-left-color:#b8862e}
.modal-zones .zone-card.zC{border-left-color:#8b4d3a}
.modal-zones .zone-card-title{
  font-family:'Fraunces',serif;
  font-size:1rem;font-weight:500;font-style:italic;
  color:var(--ink);margin-bottom:.25rem;
}
.modal-zones .zone-acads{
  font-size:.78rem;color:var(--ink-soft);line-height:1.5;
}

/* ── ONGLET RECETTES ── */
/* Écran de déverrouillage des recettes (page protégée) */
.rec-lock{
  max-width:480px;margin:2.5rem auto 0;padding:0 1rem;
}
.rec-lock-card{
  background:linear-gradient(160deg, white 0%, #f6f6f2 100%);
  border:1.5px solid var(--ocean);
  border-radius:18px;padding:2.2rem 1.6rem 1.6rem;
  text-align:center;
  box-shadow:0 8px 28px rgba(31,78,134,.12), 0 2px 6px rgba(0,0,0,.05);
  position:relative;
  overflow:hidden;
}
.rec-lock-card::before{
  content:'';position:absolute;top:-30px;right:-30px;
  width:120px;height:120px;border-radius:50%;
  background:radial-gradient(circle, rgba(31,78,134,.12), transparent 70%);
}
.rec-lock-card::after{
  content:'';position:absolute;bottom:-20px;left:-20px;
  width:90px;height:90px;border-radius:50%;
  background:radial-gradient(circle, rgba(45,95,124,.08), transparent 70%);
}
.rec-lock-icon-wrap{
  position:relative;display:inline-block;margin-bottom:.5rem;
  width:70px;height:70px;
}
.rec-lock-icon-bg{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-size:3.6rem;line-height:1;opacity:.18;transform:scale(1.2);
}
.rec-lock-icon-fg{
  position:relative;z-index:1;display:flex;align-items:center;justify-content:center;
  width:100%;height:100%;font-size:2.6rem;line-height:1;
  animation:gentleFloat 3s ease-in-out infinite;
}
@keyframes gentleFloat{
  0%,100%{transform:translateY(0) rotate(-3deg)}
  50%{transform:translateY(-5px) rotate(3deg)}
}
.rec-lock-title{
  font-family:'Fraunces',serif;font-style:italic;font-weight:600;
  font-size:1.6rem;color:var(--ink);margin:.2rem 0 .5rem;
  position:relative;
}
.rec-lock-msg{
  font-size:.88rem;color:var(--ink-soft);margin:0 0 1.3rem;
  line-height:1.55;position:relative;
}
.rec-lock-msg em{font-style:italic;color:var(--coral);font-weight:600;font-family:'Fraunces',serif}
.rec-lock-input{
  width:100%;text-align:center;font-family:'Inter',sans-serif;
  font-size:1rem;letter-spacing:.05em;margin-bottom:.7rem;
  background:white;border:1.5px solid var(--line-strong);
  position:relative;
}
.rec-lock-input:focus{border-color:var(--ocean);outline:none}
.rec-lock-error{
  min-height:1.1rem;font-size:.82rem;color:var(--coral);
  margin-bottom:.7rem;font-weight:600;position:relative;
}
.rec-lock-btn{
  width:100%;padding:.8rem;font-size:.92rem;
  background:var(--coral);position:relative;
}
.rec-lock-attempts{
  margin-top:.8rem;font-size:.75rem;color:var(--slate);
  font-family:'Inter',sans-serif;font-weight:500;
  position:relative;
}
.rec-lock-attempts.warning{color:#d97a1f;font-weight:600}
.rec-lock-attempts.danger{color:var(--coral);font-weight:700;font-size:.82rem;animation:lockPulse 1.2s infinite}
@keyframes lockPulse{0%,100%{opacity:1}50%{opacity:.55}}

.rec-lock-card.shake{animation:lockShake .5s}
@keyframes lockShake{
  0%,100%{transform:translateX(0)}
  20%{transform:translateX(-10px)}
  40%{transform:translateX(8px)}
  60%{transform:translateX(-6px)}
  80%{transform:translateX(4px)}
}

.rec-jackpot{
  position:fixed;inset:0;z-index:1500;
  background:radial-gradient(ellipse at center, rgba(200,85,61,.95), rgba(45,95,124,.95));
  display:flex;align-items:center;justify-content:center;
  animation:jackpotFadeIn .3s ease-out;
}
@keyframes jackpotFadeIn{from{opacity:0}to{opacity:1}}
.rec-jackpot-fireworks{position:absolute;inset:0;pointer-events:none}
.firework{
  position:absolute;font-size:3rem;
  animation:bounceUp 1.5s ease-out infinite;opacity:0;
}
.firework.f1{left:10%;top:20%;animation-delay:0s}
.firework.f2{left:80%;top:15%;animation-delay:.2s}
.firework.f3{left:25%;top:75%;animation-delay:.4s}
.firework.f4{left:90%;top:60%;animation-delay:.6s}
.firework.f5{left:50%;top:10%;animation-delay:.8s;font-size:4rem}
.firework.f6{left:15%;top:50%;animation-delay:1s}
.firework.f7{left:70%;top:80%;animation-delay:1.2s}
.firework.f8{left:60%;top:40%;animation-delay:1.4s;font-size:3.5rem}
@keyframes bounceUp{
  0%{transform:translateY(20px) scale(0);opacity:0}
  20%{transform:translateY(0) scale(1.4) rotate(20deg);opacity:1}
  60%{transform:translateY(-15px) scale(1) rotate(-15deg);opacity:1}
  100%{transform:translateY(-30px) scale(.6);opacity:0}
}
.rec-jackpot-card{
  background:white;border-radius:24px;
  padding:2.5rem 2rem 2rem;text-align:center;
  max-width:420px;margin:0 1rem;
  box-shadow:0 20px 60px rgba(0,0,0,.4);
  animation:popIn .6s cubic-bezier(.34, 1.56, .64, 1);
  position:relative;z-index:1;
}
@keyframes popIn{
  0%{transform:scale(.3) rotate(-15deg);opacity:0}
  100%{transform:scale(1) rotate(0);opacity:1}
}
.rec-jackpot-medal{
  font-size:5rem;line-height:1;margin-bottom:.5rem;
  animation:spinMedal 2s ease-out;display:inline-block;
}
@keyframes spinMedal{
  0%{transform:rotate(0) scale(0)}
  60%{transform:rotate(720deg) scale(1.3)}
  100%{transform:rotate(720deg) scale(1)}
}
.rec-jackpot-title{
  font-family:'Fraunces',serif;font-weight:700;
  font-size:2.4rem;color:var(--coral);margin:0 0 .6rem;
  letter-spacing:.04em;
}
.rec-jackpot-sub{
  font-size:.95rem;color:var(--ink);line-height:1.5;margin:0 0 1.5rem;
}

.rec-toolbar{
  max-width:1200px;margin:0 auto .7rem;padding:0 .75rem;
  display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;
}
.rec-search{
  flex:1;min-width:180px;max-width:380px;
  padding:.55rem .9rem;border:1px solid var(--line-strong);
  background:white;border-radius:100px;
  font-family:'Inter',sans-serif;font-size:.85rem;color:var(--ink);
}
.rec-search:focus{outline:none;border-color:var(--ocean)}
.rec-filters{
  max-width:1200px;margin:0 auto .8rem;padding:0 .75rem;
  display:flex;gap:.3rem;flex-wrap:wrap;
}
.rec-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:.75rem;
}
.rec-card{
  background:var(--sand-light);
  border:1px solid var(--line);
  border-radius:5px;
  overflow:hidden;
  cursor:pointer;
  display:flex;flex-direction:column;
  transition:transform .12s ease, box-shadow .12s ease;
}
.rec-card:active{transform:translateY(1px)}
.rec-card:hover{box-shadow:0 4px 12px rgba(29,43,54,.08)}
.rec-card-img{
  width:100%;aspect-ratio:4/3;
  background:var(--stone);
  background-size:cover;background-position:center;
  display:flex;align-items:center;justify-content:center;
  font-size:2.5rem;color:rgba(29,43,54,.18);
  border-bottom:1px solid var(--line);
  position:relative;
}
.rec-card-badge{
  position:absolute;top:.4rem;right:.4rem;
  background:rgba(255,255,255,.92);color:var(--ink-soft);
  font-size:.58rem;font-weight:700;letter-spacing:.06em;
  padding:.18rem .5rem;border-radius:100px;
  text-transform:uppercase;
}
.rec-card-badge.fam{background:var(--ocean);color:white}
/* Badge médaille pour Recettes historiques : emoji centré, fond plus contrasté */
.rec-card-badge:not(.fam){
  font-size:1rem;letter-spacing:0;
  padding:.15rem .35rem;
  background:rgba(255,255,255,.95);
  box-shadow:0 1px 3px rgba(0,0,0,.12);
}
.rec-card-badge-author{
  position:absolute;top:1.7rem;right:.4rem;
  background:rgba(255,255,255,.85);color:var(--ink-soft);
  font-size:.62rem;font-weight:600;letter-spacing:.04em;
  padding:.15rem .5rem;border-radius:100px;
  max-width:calc(100% - 1rem);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.rec-card-body{padding:.65rem .8rem .8rem;flex:1;display:flex;flex-direction:column}
.rec-card-title{
  font-family:'Fraunces',serif;font-style:italic;font-weight:500;
  font-size:1.05rem;color:var(--ink);line-height:1.2;
  margin-bottom:.15rem;
}
.rec-card-author{
  font-size:.7rem;color:var(--slate);
  letter-spacing:.06em;text-transform:uppercase;font-weight:600;
}
.rec-card-preview{
  font-size:.74rem;color:var(--ink-soft);
  margin-top:.4rem;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
  overflow:hidden;line-height:1.35;
}

/* Modal lecture recette */
.modal-rec-read{max-width:640px}
.modal-rec-read .rec-read-title{
  font-family:'Fraunces',serif;font-style:italic;
  font-size:1.6rem;color:var(--ink);line-height:1.1;
  margin-bottom:.25rem;
}
.modal-rec-read .rec-read-author{
  font-size:.72rem;color:var(--slate);
  letter-spacing:.1em;text-transform:uppercase;font-weight:600;
  margin-bottom:1rem;padding-bottom:.7rem;border-bottom:1px solid var(--line);
}
.modal-rec-read .rec-read-photos{
  display:flex;gap:.4rem;margin-bottom:1rem;flex-wrap:wrap;
}
.modal-rec-read .rec-read-photos img{
  width:calc(33.33% - .27rem);aspect-ratio:1;
  object-fit:cover;border-radius:4px;cursor:zoom-in;
  border:1px solid var(--line);
}
.modal-rec-read .welcome-p{font-size:.88rem;color:var(--ink-soft);line-height:1.55;margin:0 0 1rem}
.welcome-note{font-size:.72rem;color:var(--slate);font-style:italic;margin:.2rem 0 0}
.modal-confirm{max-width:400px}
.confirm-p{font-size:.92rem;color:var(--ink-soft);line-height:1.55;margin:.2rem 0 .6rem}
.maree-warn{background:rgba(200,133,46,.12);border:1px solid #b8862e;color:#8a6520;border-radius:3px;padding:.5rem .75rem;font-size:.76rem;margin-bottom:.7rem;line-height:1.45}
.ver-tag{
  position:fixed;right:8px;bottom:6px;z-index:500;
  font-family:'Inter',sans-serif;font-size:.62rem;font-weight:600;
  letter-spacing:.03em;color:var(--slate);opacity:.45;
  background:var(--sand-light);border:1px solid var(--stone);
  border-radius:100px;padding:.1rem .5rem;cursor:pointer;
  user-select:none;
}
.ver-tag:hover{opacity:1;color:var(--ocean);border-color:var(--ocean)}
/* ── VOLETS DE CHARGEMENT ── */
.volets{position:fixed;inset:0;z-index:1700;background:var(--sand);display:grid;place-items:center;transition:opacity .45s ease}
.volets.fini{opacity:0;pointer-events:none}
.baie{position:relative;width:210px;height:170px;perspective:700px;border:9px solid var(--stone);outline:1px solid var(--stone-strong);background:#eef3f5}
.baie-dedans{position:absolute;inset:0;display:grid;place-items:center;text-align:center}
.baie-dedans .plaque{width:168px;height:auto;display:block}
.baie-dedans small{display:block;font-size:.72rem;color:var(--slate);margin-top:.2rem;font-family:'Inter',sans-serif}
.volet{position:absolute;top:0;bottom:0;width:50%;border:1px solid #c9cdc6;
  background:repeating-linear-gradient(to bottom,#ffffff 0 6px,#d9ddd7 6px 7px);
  transition:transform .9s cubic-bezier(.5,.05,.25,1)}
.volet.g{left:0;transform-origin:left center}
.volet.d{right:0;transform-origin:right center}
.baie.ouverte .volet.g{transform:rotateY(-108deg)}
.baie.ouverte .volet.d{transform:rotateY(108deg)}
.appui{position:absolute;left:-9px;right:-9px;bottom:14px;height:4px;background:var(--ocean);border-radius:2px;z-index:2}
@media (prefers-reduced-motion:reduce){.volet,.volets{transition:none}}

/* ── ACCUEIL, MAISON, PAGES VIDES ── */
.welcome-photo{display:block;width:calc(100% + 2.4rem);height:auto;margin:-1.4rem -1.2rem 1rem;border-radius:10px 10px 0 0}
#modalWelcome .modal-handle{display:none}
.infos-maison{display:grid;grid-template-columns:130px 1fr;gap:1rem;align-items:start}
.infos-maison img{width:100%;height:auto;display:block;border-radius:4px;border:1px solid var(--line)}
.dessin-vide{width:120px;height:auto;display:block;margin:0 auto .7rem}
.upd-banner{
  position:fixed;left:50%;bottom:16px;transform:translateX(-50%);
  z-index:1300;display:flex;align-items:center;gap:.8rem;flex-wrap:wrap;
  background:var(--ink);color:var(--sand-light);
  padding:.7rem 1rem;border-radius:4px;
  box-shadow:0 6px 24px rgba(29,43,54,.35);
  font-size:.8rem;max-width:92vw;
  animation:slideUp .3s ease;
}
.upd-banner button{
  background:var(--sand-light);color:var(--ink);border:none;
  padding:.45rem .9rem;border-radius:3px;font-size:.76rem;font-weight:600;
  font-family:'Inter',sans-serif;cursor:pointer;white-space:nowrap;
}

/* ── BONS PLANS ── */
.bp-intro{display:flex;gap:.7rem;align-items:flex-start;background:var(--sand-light);
  border:1px solid var(--stone);border-left:3px solid var(--ocean);border-radius:4px;
  padding:.8rem .95rem;margin-bottom:.9rem}
.bp-intro-icon{font-size:1.1rem;line-height:1.3;flex-shrink:0}
.bp-intro p{margin:0;font-size:.8rem;color:var(--ink-soft);line-height:1.55}
.bp-bar{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin-bottom:.7rem}
.bp-switch{display:inline-flex;border:1px solid var(--line-strong);border-radius:3px;overflow:hidden}
.bp-sw{background:var(--sand-light);border:none;padding:.5rem .9rem;font-size:.76rem;font-family:'Inter',sans-serif;color:var(--ink-soft);cursor:pointer}
.bp-sw.active{background:var(--ocean);color:var(--sand-light);font-weight:600}
.bp-search{flex:1;min-width:130px;background:var(--sand-light);border:1px solid var(--line-strong);border-radius:3px;padding:.5rem .7rem;font-size:.8rem;font-family:'Inter',sans-serif;color:var(--ink)}
.bp-filters{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:.9rem}
.bp-chip{background:var(--sand-light);border:1px solid var(--line-strong);border-radius:100px;padding:.3rem .7rem;font-size:.7rem;font-family:'Inter',sans-serif;color:var(--ink-soft);cursor:pointer}
.bp-chip.on{background:var(--ocean);border-color:var(--ocean);color:var(--sand-light);font-weight:600}
.bp-tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:.8rem}
.bp-tile{background:var(--sand-light);border:1px solid var(--stone);border-left:3px solid var(--bpc,var(--ocean));border-radius:4px;padding:.9rem;display:flex;flex-direction:column;gap:.35rem}
.bp-tile-head{display:flex;align-items:center;gap:.5rem}
.bp-tile-icon{font-size:1.1rem}
.bp-tile-title{font-family:'Fraunces',serif;font-style:italic;font-weight:400;font-size:1rem;margin:0;color:var(--ink)}
.bp-tile-cat{font-size:.66rem;text-transform:uppercase;letter-spacing:.05em;color:var(--bpc,var(--slate));font-weight:600}
.bp-tile-desc{font-size:.78rem;color:var(--ink-soft);margin:.15rem 0;line-height:1.5;white-space:pre-wrap}
.bp-tile-link{font-size:.74rem;color:var(--ocean);text-decoration:none;font-weight:500}
.bp-tile-foot{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;margin-top:auto;padding-top:.5rem;border-top:1px solid rgba(0,0,0,.06)}
.bp-tile-by{font-size:.68rem;color:var(--slate);font-style:italic}
.bp-tile-loc{font-size:.68rem;color:var(--ocean)}
.bp-tile-edit{margin-left:auto;background:none;border:1px solid var(--line-strong);border-radius:3px;padding:.25rem .6rem;font-size:.68rem;font-family:'Inter',sans-serif;color:var(--ink-soft);cursor:pointer}
.bp-empty{grid-column:1/-1;text-align:center;color:var(--slate);font-style:italic;font-size:.82rem;padding:2rem 1rem}
.bp-map-wrap{position:relative}
.bp-map{height:62vh;min-height:340px;border:1px solid var(--stone);border-radius:4px;background:var(--sand-light);
  /* Leaflet empile ses calques jusqu'à z-index 1000. On les enferme dans un
     contexte isolé pour qu'ils ne passent jamais devant les fenêtres. */
  position:relative;z-index:0;isolation:isolate}
.bp-map-msg{font-size:.74rem;color:var(--slate);font-style:italic;padding:.5rem 0}
