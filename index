  // Securite : aucune modale ne doit survivre a un changement d'onglet
  document.querySelectorAll('.modal-backdrop.show').forEach(m=>m.classList.remove('show'));
  // Onglets principaux
  document.querySelectorAll('.tab-main').forEach(t=>{
