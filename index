function openBpEdit(id){
  const p = bonsPlans.find(x=>x.id===id);
  if(!p){toast('Bon plan introuvable');return}
  editingBpId = id; bpLat = (p.lat!=null?p.lat:null); bpLng = (p.lng!=null?p.lng:null);
  document.getElementById('bpModalTitle').textContent = 'Modifier le bon plan';
