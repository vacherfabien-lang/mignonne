let quickPhotoId = null, quickPhotoFam = false;
function quickAddPhoto(id, isFam){
  quickPhotoId = id; quickPhotoFam = !!isFam;
  document.getElementById('quickPhotoInput').click();
}
async function onQuickPhotoSelected(ev){
  const files = Array.from(ev.target.files||[]);
  ev.target.value = '';
  if(!files.length || !quickPhotoId) return;
  const id = quickPhotoId;
  let cur;
  if(quickPhotoFam){
    const r = recettes.find(x=>x.id===id);
    if(!r){toast('Recette introuvable');return}
    cur = [...(r.photos||[])];
  } else {
    const r = RECETTES_LOULI.find(x=>x.id===id);
    if(!r){toast('Recette introuvable');return}
    cur = collectorPhotos[id] ? [...collectorPhotos[id]] : [...(r.photos||[])];
  }
  const slots = REC_MAX_PHOTOS - cur.length;
  if(slots <= 0){ toast('Maximum ' + REC_MAX_PHOTOS + ' photos'); return; }
  toast('Compression de la photo…');
  try{
    const urls = await Promise.all(files.slice(0, slots).map(compressPhoto));
    urls.forEach(u=>{ if(u) cur.push(u); });
  }catch(e){
    console.error('Photo compression error:', e);
    toast('Impossible de traiter la photo'); return;
  }
  if(quickPhotoFam){
    const idx = recettes.findIndex(x=>x.id===id);
    recettes[idx] = { ...recettes[idx], photos: cur, updatedAt:new Date().toISOString() };
    addRecHist(id, 'Photo ajoutée');
    await saveRecettes();
  } else {
    collectorPhotos[id] = cur;
    addRecHist(id, 'Photo ajoutée');
    await saveCollectorPhotos();
    await saveRecettes();
  }
  renderRecettes();
  const fresh = quickPhotoFam ? recettes.find(x=>x.id===id) : RECETTES_LOULI.find(x=>x.id===id);
  if(fresh) openRecRead(fresh);
  toast('Photo ajoutée ✓');
}


